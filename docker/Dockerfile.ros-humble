# ROS_DISTRO selects the base. It defaults to humble, so the root
# docker-compose.yml and scripts/ros.sh build exactly what they always did.
#
# ds_ros_pipeline/compose.yaml overrides it to match the PIPELINE's distro,
# and must, because a foxglove bridge cannot read a topic published by a node
# on a different distro when any message in the tree changed shape between
# them. Concretely: cdcl_umd_msgs/TargetBoxArray embeds a sensor_msgs/Range,
# Jazzy's Range added a `float32 variance` field that Humble's lacks, and it
# sits immediately before uav_target_boxes -- so a Humble reader deserializing
# a Jazzy publisher runs 4 bytes short, reads the sequence length from the
# wrong offset, logs "sequence size exceeds remaining buffer", and hands the
# client an EMPTY box array. Every field before the Range decodes fine, which
# is what makes it look like a pipeline bug rather than a distro mismatch.
ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base

# ARGs do not survive FROM; re-declare for the apt layer below.
ARG ROS_DISTRO=humble

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/workspace/deepstream-work/src

ARG WORKSPACE_DIR=/workspace/deepstream-work
ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=1000

WORKDIR ${WORKSPACE_DIR}

# Optional visualization bridge for Foxglove Studio. Keep ROS additions near the
# end so DeepStream image rebuilds stay untouched and this layer stays cacheable.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ros-${ROS_DISTRO}-foxglove-bridge \
      ros-${ROS_DISTRO}-nav-msgs \
      ros-${ROS_DISTRO}-rosbag2-storage-mcap \
      ros-${ROS_DISTRO}-vision-msgs && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Unprivileged user matching the host UID/GID, mirroring docker/Dockerfile.
#
# Without this the container ran as root, and the one thing it writes to a bind
# mount -- the MCAP bag from `ros.sh --bag` -- came back root-owned, so the user
# who recorded it could not delete it. Kept last so the apt layer above stays
# cached when only the UID/GID change.
# ---------------------------------------------------------------------------
RUN set -eux; \
    if getent group "${USER_GID}" >/dev/null; then \
        EXISTING_GROUP="$(getent group "${USER_GID}" | cut -d: -f1)"; \
    else \
        groupadd --gid "${USER_GID}" "${USERNAME}"; \
        EXISTING_GROUP="${USERNAME}"; \
    fi; \
    if id -u "${USER_UID}" >/dev/null 2>&1; then \
        EXISTING_USER="$(getent passwd "${USER_UID}" | cut -d: -f1)"; \
        usermod -l "${USERNAME}" "${EXISTING_USER}" || true; \
        usermod -d "/home/${USERNAME}" -m "${USERNAME}" || true; \
        usermod -g "${EXISTING_GROUP}" "${USERNAME}" || true; \
    else \
        useradd --uid "${USER_UID}" --gid "${EXISTING_GROUP}" -m "${USERNAME}" --shell /bin/bash; \
    fi; \
    mkdir -p "/home/${USERNAME}"; \
    mkdir -p "${WORKSPACE_DIR}"; \
    chown -R "${USER_UID}:${USER_GID}" "/home/${USERNAME}" "${WORKSPACE_DIR}"

USER ${USERNAME}

CMD ["/bin/bash"]
