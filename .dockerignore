# Keep the build context small. Both images copy only
# docker/.bashrc.container, so nothing heavy needs to reach the daemon.
# Without this, every build shipped ~2.6 GB of models, videos and venvs.

.git/
# Glob, not a bare name: the export venvs are version-keyed (.venv-yolo-3.10),
# so ".venv-yolo/" alone let 5+ GB reach the daemon on every build.
.venv-yolo*/
.venv/
venv/
env/
.setup-state/

# Model weights, ONNX graphs and TensorRT engines
models/
*.pt
*.onnx
*.engine
*.plan
*.cache

# User-provided media and run outputs
streams/
outputs/
*.mp4
*.mkv
*.avi
*.h264
*.h265

# Cloned build dependencies and compiled artifacts
external/
lib/
build/
dist/
__pycache__/
*.pyc
*.o
*.so

# Generated DeepStream configs and the exporter's stray label drop
configs/generated/
labels.txt

# Logs and editor state
*.log
*.tlog
.vscode/
